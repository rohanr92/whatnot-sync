# --- Database (Railway fills this in automatically when you add Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/db

# --- Login password for this app ---
APP_PASSWORD=choose-a-strong-password

# --- Your public app URL (Railway domain), no trailing slash ---
APP_URL=https://your-app.up.railway.app

# --- Shopify (the OTHER store, not Menina) ---
SHOPIFY_SHOP=your-store.myshopify.com
# Option A: Dev Dashboard app (new way) — client credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: old admin custom app — fixed token (leave blank if using Option A)
SHOPIFY_ACCESS_TOKEN=
# Only for Option B: the app's "API secret key" (used to verify webhooks)
SHOPIFY_API_SECRET=

# --- Whatnot Seller API ---
WHATNOT_API_KEY=wn_pat_tk_...
WHATNOT_WEBHOOK_SECRET=wn_wh_...
